# Dev-server proxy target for /api. Defaults to http://localhost:8080.
MAPPER_API_TARGET=http://localhost:8080

# Prefix the app calls. Defaults to /api, which the dev server proxies.
VITE_API_BASE=/api

# Disclaimer gate, for development only. Unset for the real behaviour (asked
# once, remembered in localStorage).
#   always — pin the modal open on every load, for working on it
#   never  — suppress the gate, for working on everything else
# VITE_TERMS=never

# Keycloak sign-in. All three or none: unset, the app sends no bearer token,
# which is what an API with MAPPER_AUTH_* unset expects. The deploy workflow
# sets them from Terraform outputs.
# VITE_KEYCLOAK_URL=https://auth.evidence-repository.org
# VITE_KEYCLOAK_REALM=destiny
# VITE_KEYCLOAK_CLIENT_ID=research-mapper-ui-staging

# Which evidence repository the links in the UI point at. Production is the bare
# host; anything else gets a segment (data.staging.evidence-repository.org).
# Set it to match the API this build talks to.
# VITE_DESTINY_ENV=staging
