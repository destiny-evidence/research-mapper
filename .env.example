MAPPER_LLM_BASE_URL=
MAPPER_LLM_API_KEY=
MAPPER_LLM_MODEL=azure/gpt-4.1

MAPPER_DB_HOST=localhost:5433
MAPPER_DB_NAME=research_mapper
MAPPER_DB_USER=research_mapper
MAPPER_DB_PASSWORD=research_mapper

# The DESTINY repository to search
MAPPER_DESTINY_ENV=staging
# Written by `uv run python -m research_mapper login`. 
MAPPER_DESTINY_REFRESH_TOKEN=

# Keycloak bearer-token auth on the API. Unset means no auth locally.
MAPPER_AUTH_ISSUER=
MAPPER_AUTH_CLIENT_ID=

# Origins allowed to call the API cross-origin, comma separated. Unset means
# none are, which is right locally: the dev server proxies /api same-origin.
MAPPER_CORS_ORIGINS=
